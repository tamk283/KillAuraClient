package com.example.killaura.core;

import net.minecraft.client.MinecraftClient;

/**
 * Базовый класс для всех модулей.
 * Содержит общие методы и поля для управления модулями.
 */
public abstract class BaseModule {
    protected final MinecraftClient client;
    protected boolean enabled = false;
    protected final String name;

    public BaseModule(String name) {
        this.client = MinecraftClient.getInstance();
        this.name = name;
    }

    /**
     * Включает модуль.
     */
    public void enable() {
        if (!enabled) {
            enabled = true;
            onEnable();
            System.out.println(name + " enabled");
        }
    }

    /**
     * Выключает модуль.
     */
    public void disable() {
        if (enabled) {
            enabled = false;
            onDisable();
            System.out.println(name + " disabled");
        }
    }

    /**
     * Переключает состояние модуля.
     */
    public void toggle() {
        if (enabled) {
            disable();
        } else {
            enable();
        }
    }

    /**
     * Проверяет, включен ли модуль.
     * @return true, если модуль включен.
     */
    public boolean isEnabled() {
        return enabled;
    }

    /**
     * Вызывается при включении модуля.
     */
    protected void onEnable() {}

    /**
     * Вызывается при выключении модуля.
     */
    protected void onDisable() {}

    /**
     * Обновляет состояние модуля.
     * Вызывается каждый тик.
     */
    public void update() {
        if (enabled && client.player != null && client.world != null && !client.isPaused()) {
            onUpdate();
        }
    }

    /**
     * Вызывается при обновлении модуля.
     */
    protected void onUpdate() {}

    /**
     * Возвращает имя модуля.
     * @return имя модуля.
     */
    public String getName() {
        return name;
    }
}